import pandas as pd
import numpy as np

# ===================== CONFIG =====================
INPUT_CSV = "./data/policy_documents/policy_keyword_scores_all.csv"
OUTPUT_CSV = "./data/policy_documents/policy_document_keyword_matrix.csv"

TOP_K_PERCENT = 0.10  # top 10% (can adjust to 0.03 for top-3% style)

# ===================== LOAD =====================

df = pd.read_csv(INPUT_CSV)

# Expected columns:
# document, chunk_index, keyword, similarity, chunk_preview

# ===================== TOP-K AGGREGATION =====================

def compute_topk_score(group, k_percent=0.10):
    """
    Given all chunk-level scores for (document, keyword),
    return the mean of the top k% scores.
    """
    scores = group["similarity"].values

    if len(scores) == 0:
        return 0.0

    k = max(1, int(len(scores) * k_percent))
    top_k_scores = np.sort(scores)[-k:]

    return float(np.mean(top_k_scores))

# Group by document + keyword
agg_df = (
    df.groupby(["document", "keyword"])
    .apply(lambda g: compute_topk_score(g, TOP_K_PERCENT))
    .reset_index(name="score")
)

# ===================== PIVOT TO MATRIX =====================

# Rows = documents, Columns = keywords
matrix_df = agg_df.pivot(index="document", columns="keyword", values="score")

# Fill missing with 0 (no signal)
matrix_df = matrix_df.fillna(0.0)

# ===================== ROW NORMALIZATION =====================

def row_normalize(matrix):
    """
    Normalize each row so it sums to 1.
    """
    row_sums = matrix.sum(axis=1, keepdims=True)

    # Avoid division by zero
    row_sums[row_sums == 0] = 1

    return matrix / row_sums

normalized_matrix = row_normalize(matrix_df.values)

normalized_df = pd.DataFrame(
    normalized_matrix,
    index=matrix_df.index,
    columns=matrix_df.columns
)

# ===================== SAVE =====================

normalized_df.to_csv(OUTPUT_CSV)

print("[DONE] Policy document-keyword matrix saved.")
print(f"Shape: {normalized_df.shape}")
